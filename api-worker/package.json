{
  "name": "shattered-saga-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shattered Saga auth + AI proxy Worker (Better Auth on Cloudflare Workers + D1).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "auth:generate": "better-auth generate --config src/auth.ts --output src/db/auth.schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DATABASE --local",
    "db:migrate:remote": "wrangler d1 migrations apply DATABASE --remote"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "better-auth-cloudflare": "^0.3.1",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/workers-types": "^5.20260730.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}

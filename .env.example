# Shattered Saga — frontend build-time environment (Vite).
# Copy to `.env` and fill in. For the deployed site, set these as GitHub Actions
# secrets (see .github/workflows/deploy.yml) so they are injected at build time.

# Shared Gemini API key for the Free engine (format: AIza...). Also used as the
# Worker's DEV_GEMINI_KEY. Get one at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Supabase project (Auth + profiles/energy). WITHOUT these the app runs in
# "Local Simulation" mode (no real accounts, no server-metered play).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Worker proxy URL for server-metered Free/Premium play (legacy).
# Defaults in code to https://proxy.shatteredsaga.workers.dev if unset.
VITE_PROXY_URL=

# Better Auth API Worker base URL (api-worker/). When set, the app uses Better
# Auth for login + metered play instead of the legacy Supabase/simulation path.
# Leave blank until the Worker is deployed. Local dev: http://localhost:8787
VITE_API_URL=
